# Required. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
DRAFTBIN_TOKEN=

# The origin draft links are built from. Must match your Cloudflare tunnel hostname.
DRAFTBIN_PUBLIC_BASE_URL=https://drafts.example.com

# auto follows each reader's OS setting; light and dark are unconditional.
DRAFTBIN_THEME=auto

DRAFTBIN_DATA_DIR=/data
DRAFTBIN_DEFAULT_TTL_SECONDS=86400
DRAFTBIN_MAX_TTL_SECONDS=604800
DRAFTBIN_MAX_UPLOAD_BYTES=2097152
DRAFTBIN_SWEEP_INTERVAL_SECONDS=300

# Only used by docker-compose.yml to run the tunnel alongside the app.
CLOUDFLARE_TUNNEL_TOKEN=
