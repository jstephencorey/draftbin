# Required. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
DRAFTBIN_TOKEN=

# The origin draft links are built from. Must match your Cloudflare tunnel hostname.
DRAFTBIN_PUBLIC_BASE_URL=https://draftbin.example.com

# auto follows each reader's OS setting; light and dark are unconditional.
DRAFTBIN_THEME=auto

# IANA zone for dates shown to readers. API responses stay in UTC regardless.
DRAFTBIN_TIMEZONE=UTC

DRAFTBIN_DATA_DIR=/data
DRAFTBIN_DEFAULT_TTL_SECONDS=2592000
DRAFTBIN_MAX_TTL_SECONDS=31536000
DRAFTBIN_MAX_UPLOAD_BYTES=2097152
DRAFTBIN_SWEEP_INTERVAL_SECONDS=300

# How long a dead draft URL keeps saying "expired" rather than "never existed".
DRAFTBIN_TOMBSTONE_RETENTION_SECONDS=2592000

